{
  "mcpServers": {
    "context7": {
      "command": "cmd",
      "args": ["/c", "pnpm", "dlx", "@upstash/context7-mcp@4.1.1"]
    },
    "playwright": {
      "command": "cmd",
      "args": ["/c", "pnpm", "dlx", "@playwright/mcp@0.0.82"]
    },
    "postgres-dev": {
      "command": "node",
      "args": ["scripts/mcp/postgres-dev.mjs"]
    },
    "redis-dev": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--network",
        "container:iwana_redis_dev",
        "--env-file",
        ".claude/mcp-redis.local.env",
        "mcp/redis@sha256:e886a7e9990a084a20d46adcea8e7c89d539271f1b453ffabdce4c3f96f27fa0"
      ]
    }
  }
}
