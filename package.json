{
  "name": "iwana-next",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "iWana neXt — ISP/OSS/BSS/NMS Platform Colombia",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "db:apply-least-privilege": "node scripts/db/apply-least-privilege.mjs",
    "db:backup": "node scripts/db/backup.mjs",
    "db:restore": "node scripts/db/restore.mjs",
    "db:migrate:all": "pnpm --filter @iwana/db build && pnpm --filter @iwana/db migration:run && pnpm --filter @iwana/db migration:tenant:run && pnpm db:apply-least-privilege",
    "db:purge-backups": "node scripts/db/purge-backups.mjs",
    "encryption:reencrypt": "pnpm --filter @iwana/api encryption:reencrypt",
    "dev:free-ports": "node scripts/free-dev-ports.mjs",
    "dev:verify-platform-login": "node scripts/dev-verify-platform-login.mjs",
    "dev:reset-platform-admin": "node scripts/dev-reset-platform-admin.mjs",
    "test:tooling": "node --test scripts/dev.test.mjs scripts/free-dev-ports.test.mjs scripts/nginx-config.test.mjs",
    "dev": "node scripts/dev.mjs",
    "audit:adr-citations": "node scripts/audit-adr-citations.mjs",
    "audit:doc-locations": "node scripts/audit-doc-locations.mjs",
    "sync:agents": "node scripts/sync-agents.mjs",
    "sync:agents:check": "node scripts/sync-agents.mjs --check",
    "lint": "turbo run lint",
    "test": "turbo run test --concurrency=1",
    "test:coverage": "turbo run test --concurrency=1 --only -- --coverage --coverageReporters=text-summary --coverageReporters=json-summary",
    "test:e2e": "playwright test --config e2e/playwright.web.config.ts",
    "test:e2e:headed": "playwright test --config e2e/playwright.web.config.ts --headed",
    "test:e2e:portal": "playwright test --config e2e/playwright.portal.config.ts",
    "test:e2e:all": "pnpm test:e2e && pnpm test:e2e:portal",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && node scripts/clean-paths.mjs node_modules .turbo test-results apps/portal/test-results apps/api/coverage",
    "prepare": "husky",
    "clean:src-artifacts": "node scripts/clean-src-artifacts.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@playwright/test": "^1.58.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.9.14",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "cross-env": "^10.1.0"
  },
  "pnpm": {
    "overrides": {
      "handlebars": ">=4.7.9",
      "brace-expansion@<1.1.16": ">=1.1.16",
      "brace-expansion@>=2.0.0 <2.1.2": ">=2.1.2",
      "picomatch@<2.3.2": ">=2.3.2",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "path-to-regexp@>=8.0.0 <8.4.0": ">=8.4.0",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0",
      "js-yaml@<3.15.0": ">=3.15.0",
      "js-yaml@>=4.0.0 <4.3.0": ">=4.3.0",
      "fast-uri@>=3.0.0 <3.1.4": ">=3.1.4",
      "fast-xml-builder@<=1.1.6": ">=1.1.7",
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6",
      "lodash@>=4.0.0 <=4.17.23": ">=4.18.0",
      "flatted@<=3.4.1": ">=3.4.2",
      "nodemailer@<=8.0.8": ">=8.0.9",
      "multer@>=1.0.0 <2.2.0": ">=2.2.0",
      "typeorm@<0.3.31": ">=0.3.31",
      "sharp@<0.35.0": ">=0.35.0",
      "postcss@<=8.5.17": ">=8.5.18",
      "brace-expansion@>=5.0.0 <5.0.8": ">=5.0.8",
      "yaml@>=2.0.0 <2.8.3": ">=2.8.3",
      "uuid@<11.1.1": ">=11.1.1",
      "qs@>=6.11.1 <=6.15.1": ">=6.15.2",
      "joi@>=18.0.0 <18.2.1": ">=18.2.1",
      "@nestjs/core@<=11.1.17": ">=11.1.18",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "body-parser@>=2.0.0 <2.3.0": ">=2.3.0",
      "@babel/core@<=7.29.0": ">=7.29.6 <8.0.0",
      "@tootallnate/once@<2.0.1": ">=2.0.1"
    }
  }
}
