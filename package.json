      "@nestjs/core",
      "msgpackr-extract",
      "sharp"
    ]
  },
  "devDependencies": {
    "turbo": "latest",
    "typescript": "^5.9.0",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "eslint": "^9.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "eslint-config-prettier": "^9.0.0"
  }
}
