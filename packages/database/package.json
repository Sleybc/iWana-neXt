{
  "name": "@iwana/db",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "node ../../scripts/clean-paths.mjs dist && tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "eslint src --ext .ts",
    "test": "jest --passWithNoTests",
    "test:integration": "jest --config jest.integration.config.js --passWithNoTests",
    "clean": "node ../../scripts/clean-paths.mjs dist",
    "migration:run": "typeorm migration:run -d dist/data-source.js",
    "migration:revert": "typeorm migration:revert -d dist/data-source.js",
    "migration:show": "typeorm migration:show -d dist/data-source.js",
    "migration:tenant:run": "node dist/cli/tenant-migrate.js",
    "migration:tenant:revert": "node dist/cli/tenant-revert.js",
    "reconcile:visit-request-statuses": "node dist/cli/reconcile-visit-request-statuses.js",
    "reconcile:evidence-upload": "node dist/cli/reconcile-evidence-upload-idempotency.js"
  },
  "dependencies": {
    "@iwana/shared": "workspace:*",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.0",
    "typeorm": "0.3.28"
  },
  "devDependencies": {
    "@iwana/config": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.0"
  }
}
