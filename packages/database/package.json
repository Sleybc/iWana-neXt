{
  "name": "@iwana/db",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist",
    "migration:run": "typeorm migration:run -d dist/data-source.js",
    "migration:revert": "typeorm migration:revert -d dist/data-source.js",
    "migration:show": "typeorm migration:show -d dist/data-source.js",
    "migration:tenant:run": "node dist/migrations/tenant/003_add_user_profile_fields.js",
    "migration:tenant:004": "node dist/migrations/tenant/004_add_mfa_required_to_users.js"
  },
  "dependencies": {
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.0",
    "typeorm": "0.3.28"
  },
  "devDependencies": {
    "@iwana/config": "workspace:*",
    "@iwana/shared": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.9.0"
  }
}
