# syntax=docker/dockerfile:1.7
ARG NODE_VERSION=24.13.1
# Manifest-list digests resolved with `docker buildx imagetools inspect` for
# the exact Node patch and Debian variants used by this image.
ARG NODE_BOOKWORM_DIGEST=sha256:00e9195ebd49985a6da8921f419978d85dfe354589755192dc090425ce4da2f7
ARG NODE_BOOKWORM_SLIM_DIGEST=sha256:a81a03dd965b4052269a57fac857004022b522a4bf06e7a739e25e18bce45af2

FROM node:${NODE_VERSION}-bookworm@${NODE_BOOKWORM_DIGEST} AS base
ARG NODE_VERSION
ARG NODE_BOOKWORM_DIGEST
ARG NODE_BOOKWORM_SLIM_DIGEST
RUN test "$NODE_VERSION" = "24.13.1" \
    && test "$NODE_BOOKWORM_DIGEST" = "sha256:00e9195ebd49985a6da8921f419978d85dfe354589755192dc090425ce4da2f7" \
    && test "$NODE_BOOKWORM_SLIM_DIGEST" = "sha256:a81a03dd965b4052269a57fac857004022b522a4bf06e7a739e25e18bce45af2"
WORKDIR /app
RUN npm install -g pnpm@10.32.1

FROM base AS deps
COPY pnpm-lock.yaml package.json pnpm-workspace.yaml ./
COPY packages/database/package.json ./packages/database/
COPY packages/shared/package.json ./packages/shared/
COPY packages/config/package.json ./packages/config/
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    CI=true HUSKY=0 pnpm install --store-dir=/pnpm/store --frozen-lockfile --ignore-scripts

FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages/database/node_modules ./packages/database/node_modules
COPY --from=deps /app/packages/shared/node_modules ./packages/shared/node_modules
COPY --from=deps /app/packages/config/node_modules ./packages/config/node_modules
COPY packages/database/package.json ./packages/database/
COPY packages/shared/package.json ./packages/shared/
COPY packages/config/package.json ./packages/config/
COPY packages/database ./packages/database
COPY packages/shared ./packages/shared
COPY packages/config ./packages/config
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm exec tsc --project packages/shared/tsconfig.json && \
    pnpm exec tsc --project packages/database/tsconfig.json
RUN CI=true HUSKY=0 pnpm --filter @iwana/db deploy --prod --legacy --ignore-scripts /output

# `pnpm deploy` copies package files and can retain known package artifacts from
# the build workspace. Remove only those root artifacts; never prune matching
# names recursively inside runtime dependencies.
RUN set -eu; \
    find /output/dist -type f \( \
      -name '*.map' -o \
      -name '*.d.ts' -o \
      -name '*.ts' -o \
      -name '*.tsx' \
    \) -delete; \
    rm -rf -- \
      /output/src \
      /output/test \
      /output/jest.config.js \
      /output/jest.integration.config.js \
      /output/tsconfig.json \
      /output/tsconfig.typecheck.json \
      /output/Dockerfile.migrator \
      /output/pnpm-lock.yaml \
      /output/pnpm-workspace.yaml; \
    rm -rf -- /output/node_modules/cross-env; \
    rm -rf -- /output/node_modules/.bin/cross-env; \
    cross_env_virtual_store_dir="$(find /output/node_modules/.pnpm -mindepth 1 -maxdepth 1 -type d -name 'cross-env@*' -print -quit)"; \
    test -n "$cross_env_virtual_store_dir"; \
    rm -rf -- "$cross_env_virtual_store_dir"; \
    test -f /output/dist/data-source.js; \
    test -f /output/dist/cli/tenant-migrate.js; \
    test -f /output/node_modules/typeorm/cli.js; \
    test -z "$(find /output/dist -type f \( -name '*.map' -o -name '*.d.ts' -o -name '*.ts' -o -name '*.tsx' \) -print -quit)"; \
    test "$(find /output -mindepth 1 -maxdepth 1 -printf '%f\n' | sort | tr '\n' ' ')" = 'dist node_modules package.json '; \
    test ! -e /output/node_modules/cross-env; \
    test ! -L /output/node_modules/cross-env; \
    test ! -e /output/node_modules/.bin/cross-env; \
    test ! -L /output/node_modules/.bin/cross-env; \
    test -z "$(find /output/node_modules -mindepth 1 \( -type d -o -type f -o -type l \) \( -name 'cross-env' -o -name 'cross-env@*' \) -print -quit)"

# Smoke-run the TypeORM CLI and load the compiled runtime after pruning without
# initializing a database connection; fail the build if the CLI dependency
# closure or compiled tenant runner is incomplete.
RUN cd /output && \
    node node_modules/typeorm/cli.js --help && \
    test -f ./dist/cli/tenant-migrate.js && \
    node --input-type=module -e "import { accessSync } from 'node:fs'; const { AppDataSource } = await import('./dist/data-source.js'); await import('./dist/migrations/tenant/runner.js'); if (AppDataSource.isInitialized) throw new Error('DataSource must not connect during the build smoke test'); accessSync('./dist/cli/tenant-migrate.js');"

FROM node:${NODE_VERSION}-bookworm-slim@${NODE_BOOKWORM_SLIM_DIGEST} AS runner
WORKDIR /app
ENV NODE_ENV=production HOME=/home/node
COPY --from=builder --chown=node:node /output ./
USER node
CMD ["sh", "-ec", "node node_modules/typeorm/cli.js migration:run -d dist/data-source.js && node dist/cli/tenant-migrate.js"]
