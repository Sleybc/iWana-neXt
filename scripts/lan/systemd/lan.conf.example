# /etc/iwana/lan.conf — configuración del entorno estable en la LAN (sin secretos).
# Los secretos viven solo en IWANA_ENV_FILE (chmod 600, fuera de Git).
IWANA_REPO=@REPO@
IWANA_ENV_FILE=@REPO@/.env.stable
IWANA_BACKUP_DIR=/var/backups/iwana
# Engine del sistema, no el contexto de Docker Desktop del usuario.
DOCKER_HOST=unix:///var/run/docker.sock
COMPOSE_PROJECT_NAME=iwana-stable
# Copia cifrada fuera del host: descomentar las cinco tras el runbook §1.3 paso 7.
# IWANA_OFFSITE_CMD=@REPO@/scripts/lan/offsite-restic.sh
# IWANA_OFFSITE_SSH=iwana-backup@REPLACE_ME
# IWANA_OFFSITE_KEY=/home/REPLACE_ME/.config/iwana-stable/offsite_ed25519
# IWANA_OFFSITE_KNOWN_HOSTS=/home/REPLACE_ME/.config/iwana-stable/offsite_known_hosts
# RESTIC_PASSWORD_FILE=/home/REPLACE_ME/.config/iwana-stable/offsite.pass
IWANA_LAN_IFACE=eno1
IWANA_LAN_SERVER_IP=10.0.0.254
IWANA_LAN_ALLOW=10.0.0.0/24
IWANA_HEALTH_URL=https://10.0.0.254/api/v1/health
IWANA_TLS_DIR=/etc/iwana/tls
IWANA_CA_FILE=/etc/iwana/tls/root-ca.crt
IWANA_DISK_PATHS="/ /var/lib/docker /var/backups"
