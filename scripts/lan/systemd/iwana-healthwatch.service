# Monitoreo mínimo del entorno estable (plan 2026-11-24 §3.3).
[Unit]
Description=iWana: salud, contenedores, disco y certificado
After=docker.service

[Service]
Type=oneshot
User=@USER@
Group=docker
Environment=PATH=@PATH@
EnvironmentFile=/etc/iwana/lan.conf
ExecStart=@REPO@/scripts/lan/healthwatch.sh
