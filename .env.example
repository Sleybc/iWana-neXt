# Plantilla de entorno iWana neXt — SIN secretos reales.
# Copiar a .env / .env.development (gitignored) y completar.
# Generar claves: openssl rand -hex 32   |   bash scripts/generate-secrets.sh
#
# Invocación de Compose en desarrollo (la publicación de puertos, ligada a
# 127.0.0.1, vive en el archivo de desarrollo):
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d
# `pnpm dev` ya usa esa invocación y valida las variables obligatorias antes de
# llamar a Docker.
#
# Variables que `docker-compose.yml` exige sin default (el preflight de
# `scripts/dev.mjs` las verifica): DB_BOOTSTRAP_USER, DB_PASSWORD, DB_APP_USER,
# DB_APP_PASSWORD, DB_MIGRATOR_USER, DB_MIGRATOR_PASSWORD, MINIO_ROOT_USER,
# MINIO_ROOT_PASSWORD, TYPESENSE_API_KEY, PGBOUNCER_IMAGE, MINIO_IMAGE,
# MINIO_MC_IMAGE y NGINX_IMAGE. ADMINER_IMAGE es opcional y solo se usa con el
# perfil explícito `adminer`.
#
# `pnpm dev` levanta postgres, redis, pgbouncer, minio, typesense y nginx con
# `up --wait`, y después ejecuta el one-shot `minio-init`, que crea el bucket
# S3_BUCKET. Sin ese paso el módulo de medios falla con `NoSuchBucket`.

NODE_ENV=development

# --- Referencias de imágenes ---
# Requeridas explícitamente por `docker-compose.yml`; no usar tags flotantes ni
# `:latest`. Las cuatro referencias siguientes son las que el perfil de desarrollo
# necesita y están verificadas con `docker manifest inspect`; no son secretos.
# Para producción, las referencias aprobadas se declaran en `.env.production`
# (ver `.env.production.example`).
PGBOUNCER_IMAGE=edoburu/pgbouncer:v1.24.1-p1
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z
NGINX_IMAGE=nginx:1.31.2-alpine
# Herramienta opcional de inspección local; no la levanta `pnpm dev`.
ADMINER_IMAGE=adminer:5.4.2
# Estas tres sí tienen default en `docker-compose.yml`. Se declaran aquí para que
# el pin sea visible y auditable desde un único archivo; descomentar solo para
# fijar una versión distinta de la del compose.
# POSTGRES_IMAGE=postgres:18.3-alpine
# REDIS_IMAGE=redis:8.6-alpine
# TYPESENSE_IMAGE=typesense/typesense:28.0

# --- JWT RS256 ---
# Placeholders deliberadamente inválidos: no son claves ni secretos.
# Sustituir únicamente en archivos locales no versionados por el par PEM real;
# producción requiere JWT_PRIVATE_KEY y JWT_PUBLIC_KEY.
JWT_PRIVATE_KEY=CHANGE_ME_NOT_A_REAL_PRIVATE_KEY
JWT_PUBLIC_KEY=CHANGE_ME_NOT_A_REAL_PUBLIC_KEY

# --- PostgreSQL / compose ---
# GSEC-N1: tres identidades distintas, nunca acopladas.
#   DB_BOOTSTRAP_USER → POSTGRES_USER, superusuario que crea el entrypoint en un
#     datadir vacío. Solo para init y scripts/db/*. NUNCA como runtime.
#   DB_APP_USER       → rol de aplicación de API/worker y pgBouncer.
#   DB_MIGRATOR_USER  → rol de migraciones y DDL de provisioning.
# Si el bootstrap coincide con app o migrator, el rol queda SUPERUSER y SEC-04
# se anula: el init (docker/postgres/init/01-create-roles.sh) falla en duro.
DB_BOOTSTRAP_USER=iwana
DB_HOST=localhost
DB_PORT=5433
DB_NAME=dbiw
DB_PASSWORD=

# SEC-04 least privilege. Ver docs/runbooks/RUNBOOK-DB-LEAST-PRIVILEGE-v1.0.md
# API/worker/pgBouncer → DB_APP_USER=iwana_app (≠ DB_BOOTSTRAP_USER).
# Migraciones CLI + provisioning DDL leen DB_MIGRATOR_*.
DB_APP_USER=iwana_app
DB_APP_PASSWORD=
DB_MIGRATOR_USER=iwana_migrator
DB_MIGRATOR_PASSWORD=

# pgBouncer (apps locales suelen usar DB_PORT directo, no el pool)
PGBOUNCER_PORT=6433

# --- Puertos publicados en el host (docker-compose.dev.yml, todos en 127.0.0.1) ---
# Tienen default en Compose; se declaran aquí para poder resolver un choque de
# puertos sin editar los archivos de Compose.
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003
# Proxy nginx de desarrollo (docker-compose.yml).
DEV_PROXY_PORT=8080
# Solo con el perfil explícito `adminer`.
ADMINER_PORT=8081

# --- Cifrado AES-256-GCM (SEC-02 / ADR-058) ---
# Obligatorio: 64 hex de entropía real. NUNCA 64 ceros ni placeholders.
# Placeholder vacío deliberadamente inválido — generar y pegar solo en archivos no versionados.
# Producción requiere MFA_ENCRYPTION_KEY; nunca usar ceros ni valores repetidos.
#   openssl rand -hex 32
MFA_ENCRYPTION_KEY=
# Solo durante ventana de rotación (clave antigua). Vacío en operación normal.
# Ver docs/runbooks/RUNBOOK-ENCRYPTION-KEY-ROTATION-v1.0.md
MFA_ENCRYPTION_KEY_PREVIOUS=

# Idempotencia de órdenes de ejecución (mínimo 32 caracteres aleatorios).
# Placeholder no válido: generar un secreto real solo en archivos no versionados.
EXECUTION_ORDER_IDEMPOTENCY_SECRET=

# Telemetría del relay outbox. Vacío = sin umbral aprobado; no se usa valor implícito.
OUTBOX_RELAY_LAG_DEGRADED_SECONDS=
OUTBOX_RELAY_LAG_STOPPED_SECONDS=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380
# El baseline vigente no exige autenticación Redis. Riesgo residual: una instancia
# expuesta sin REDIS_PASSWORD permite acceso no autenticado; mantener Redis en la
# red interna y definir el control obligatorio en SEC-ENG/ADR antes de exponerlo.
REDIS_PASSWORD=

# --- MinIO / almacenamiento S3 ---
# Placeholders deliberadamente inválidos; producción falla al arrancar si faltan.
MINIO_ROOT_USER=CHANGE_ME_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD
S3_ACCESS_KEY_ID=CHANGE_ME_S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=CHANGE_ME_S3_SECRET_ACCESS_KEY
S3_BUCKET=iwana-media

# --- Typesense ---
# No usar una clave de ejemplo en producción: Compose y la API la exigen.
TYPESENSE_API_KEY=CHANGE_ME_TYPESENSE_API_KEY
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108

# --- Bootstrap del superadministrador de plataforma ---
# Los consume apps/api/src/modules/auth/platform-bootstrap.service.ts en el
# arranque. Placeholders deliberadamente inválidos: sustituir solo en archivos
# locales no versionados. Ver `pnpm dev:reset-platform-admin`.
PLATFORM_SUPER_ADMIN_EMAIL=CHANGE_ME_PLATFORM_SUPER_ADMIN_EMAIL
PLATFORM_SUPER_ADMIN_PASSWORD=CHANGE_ME_PLATFORM_SUPER_ADMIN_PASSWORD
