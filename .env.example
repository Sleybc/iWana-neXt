# Plantilla de entorno iWana neXt — SIN secretos reales.
# Copiar a .env / .env.development (gitignored) y completar.
# Generar claves: openssl rand -hex 32   |   bash scripts/generate-secrets.sh

NODE_ENV=development

# --- PostgreSQL / compose ---
# Bootstrap del volumen Docker (POSTGRES_USER). En staging/prod NO usar como runtime.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=dbiw
DB_USER=iwana
DB_PASSWORD=

# SEC-04 least privilege (opt-in). Ver docs/runbooks/RUNBOOK-DB-LEAST-PRIVILEGE-v1.0.md
# Tras apply-least-privilege: API/worker → DB_USER=iwana_app.
# Migraciones CLI + provisioning DDL leen DB_MIGRATOR_* (fallback a DB_USER si vacío/omitido).
DB_APP_USER=iwana_app
DB_APP_PASSWORD=
DB_MIGRATOR_USER=iwana_migrator
DB_MIGRATOR_PASSWORD=

# pgBouncer (apps locales suelen usar DB_PORT directo, no el pool)
PGBOUNCER_PORT=6433

# --- Cifrado AES-256-GCM (SEC-02 / ADR-058) ---
# Obligatorio: 64 hex de entropía real. NUNCA 64 ceros ni placeholders.
# Vacío a propósito en la plantilla — generar y pegar solo en archivos no versionados:
#   openssl rand -hex 32
MFA_ENCRYPTION_KEY=
# Solo durante ventana de rotación (clave antigua). Vacío en operación normal.
# Ver docs/runbooks/RUNBOOK-ENCRYPTION-KEY-ROTATION-v1.0.md
MFA_ENCRYPTION_KEY_PREVIOUS=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380
