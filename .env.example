# =============================================================================
# iWana neXt — Variables de Entorno
# =============================================================================
# INSTRUCCIONES:
#   1. Copiar este archivo como .env en la raiz del workspace para docker-compose.yml
#   2. Usar apps/api/.env para desarrollo local de la API
#   3. Completar todos los valores marcados como <CAMBIAR>
#   4. Ejecutar scripts/generate-secrets.sh para generar el par JWT RSA
#   5. Nunca commitear secretos, tokens ni valores reales
#
# Referencias:
#   - HLD-MOD01-ARQUITECTURA-v1.0 Seccion 7 (Variables de entorno)
#   - docs/security/secrets-management.md
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
APP_URL=https://api.example.com
PORTAL_URL=https://portal.example.com
WEB_URL=https://app.example.com

# -----------------------------------------------------------------------------
# Base de Datos — PostgreSQL 16
# -----------------------------------------------------------------------------
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=iwana
DATABASE_PASSWORD=<CAMBIAR>
DATABASE_NAME=iwana_next
DATABASE_SCHEMA=public

# Variables equivalentes para la app NestJS
DB_HOST=postgres
DB_PORT=5432
DB_USER=iwana
DB_PASSWORD=<CAMBIAR>
DB_NAME=iwana_next

# pgBouncer (connection pooling)
PGBOUNCER_HOST=pgbouncer
PGBOUNCER_PORT=6432

# -----------------------------------------------------------------------------
# Redis 8
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<CAMBIAR>
REDIS_DB=0

# -----------------------------------------------------------------------------
# JWT — RS256
# Produccion: inyectar contenido PEM escapado con \n desde vault/secret manager.
# Desarrollo local: apps/api/.env puede seguir usando claves locales.
# -----------------------------------------------------------------------------
JWT_PRIVATE_KEY=<CAMBIAR_PEM_ESCAPADO>
JWT_PUBLIC_KEY=<CAMBIAR_PEM_ESCAPADO>
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# -----------------------------------------------------------------------------
# Cifrado — AES-256-GCM
# Generar con: openssl rand -hex 32
# -----------------------------------------------------------------------------
MFA_ENCRYPTION_KEY=<CAMBIAR_generar_con_openssl_rand_-hex_32>

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# -----------------------------------------------------------------------------
# BullMQ — Redis para colas de jobs
# -----------------------------------------------------------------------------
BULL_REDIS_HOST=redis
BULL_REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Email — SMTP (usar Mailtrap en desarrollo)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=<CAMBIAR>
SMTP_PASS=<CAMBIAR>
SMTP_FROM=no-reply@example.com

# -----------------------------------------------------------------------------
# MinIO — Almacenamiento de objetos
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=<CAMBIAR>
MINIO_SECRET_KEY=<CAMBIAR>
MINIO_USE_SSL=false
MINIO_BUCKET=iwana-prod

# -----------------------------------------------------------------------------
# URLs de Aplicaciones
# -----------------------------------------------------------------------------
CORS_ORIGIN=https://app.example.com

# -----------------------------------------------------------------------------
# Bootstrap opcional del superusuario de plataforma
# Usar solo en aprovisionamiento controlado; no versionar valores reales
# -----------------------------------------------------------------------------
PLATFORM_SUPER_ADMIN_EMAIL=<CAMBIAR>
PLATFORM_SUPER_ADMIN_PASSWORD=<CAMBIAR>

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info
