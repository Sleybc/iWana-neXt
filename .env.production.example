# Plantilla de producción: no contiene secretos ni referencias desplegables.
# Copiar a .env.production (archivo local, ignorado por git) y reemplazar TODOS
# los valores CHANGE_ME/REPLACE_ME por valores del secret store y referencias de
# imagen aprobadas para el release.
#
# Validación segura (no imprime la configuración ni sus secretos):
#   docker compose --env-file .env.production --profile production -f docker-compose.yml config --quiet
# Arranque explícito, siempre con el mismo archivo:
#   docker compose --env-file .env.production --profile production -f docker-compose.yml up -d
# Nunca ejecutar `docker compose config` sin `--quiet` en una terminal compartida.

NODE_ENV=production

# El Stack Tecnológico aprueba PostgreSQL 18.3 y Redis 8.6 como baseline.
POSTGRES_IMAGE=postgres:18.3-alpine
REDIS_IMAGE=redis:8.6-alpine
TYPESENSE_IMAGE=typesense/typesense:28.0

# Estas referencias no tienen versión aprobada en Stack_Tecnologico.md.
# Deben ser resueltas y aprobadas por R0/R3.1 antes del despliegue; no usar latest.
PGBOUNCER_IMAGE=REPLACE_ME_WITH_APPROVED_PGBOUNCER_IMAGE
MINIO_IMAGE=REPLACE_ME_WITH_APPROVED_MINIO_IMAGE
MINIO_MC_IMAGE=REPLACE_ME_WITH_APPROVED_MINIO_MC_IMAGE
NGINX_IMAGE=REPLACE_ME_WITH_APPROVED_NGINX_IMAGE
MIGRATOR_IMAGE=REPLACE_ME_WITH_RELEASE_MIGRATOR_IMAGE
ADMINER_IMAGE=REPLACE_ME_WITH_APPROVED_ADMINER_IMAGE

DB_BOOTSTRAP_USER=REPLACE_ME_DB_BOOTSTRAP_USER
DB_HOST=postgres
DB_PORT=5432
DB_NAME=REPLACE_ME_DB_NAME
DB_USER=REPLACE_ME_DB_APP_USER
DB_PASSWORD=REPLACE_ME_DB_PASSWORD
DB_APP_USER=REPLACE_ME_DB_APP_USER
DB_APP_PASSWORD=REPLACE_ME_DB_APP_PASSWORD
DB_MIGRATOR_USER=REPLACE_ME_DB_MIGRATOR_USER
DB_MIGRATOR_PASSWORD=REPLACE_ME_DB_MIGRATOR_PASSWORD

REDIS_HOST=redis
REDIS_PORT=6379
PGBOUNCER_PORT=6432

JWT_PRIVATE_KEY=REPLACE_ME_JWT_PRIVATE_KEY
JWT_PUBLIC_KEY=REPLACE_ME_JWT_PUBLIC_KEY
EXECUTION_ORDER_IDEMPOTENCY_SECRET=REPLACE_ME_EXECUTION_ORDER_IDEMPOTENCY_SECRET
MFA_ENCRYPTION_KEY=REPLACE_ME_MFA_ENCRYPTION_KEY

MINIO_ROOT_USER=REPLACE_ME_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=REPLACE_ME_MINIO_ROOT_PASSWORD
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=REPLACE_ME_S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=REPLACE_ME_S3_SECRET_ACCESS_KEY
S3_BUCKET=iwana-media
S3_FORCE_PATH_STYLE=true
STORAGE_DRIVER=minio

TYPESENSE_API_KEY=REPLACE_ME_TYPESENSE_API_KEY
TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108

API_PORT=3000
WEB_PORT=3001
PORTAL_PORT=3002
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
