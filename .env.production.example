# Plantilla de producción: no contiene secretos; las referencias pendientes son
# deliberadamente no operativas.
# Copiar a .env.production (archivo local, ignorado por git) y reemplazar TODOS
# los valores CHANGE_ME/REPLACE_ME por valores del secret store y referencias de
# imagen aprobadas para el release.
#
# El perfil production vive en `docker-compose.prod.yml`; `docker-compose.yml`
# solo declara la infraestructura compartida. Ambas invocaciones requieren los
# DOS archivos: con uno solo faltarían los servicios *-prod.
#
# Validación segura (no imprime la configuración ni sus secretos):
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml \
#     --profile production --env-file .env.production config --quiet
# Arranque explícito, siempre con los mismos archivos:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml \
#     --profile production --env-file .env.production up -d
# Nunca ejecutar `docker compose config` sin `--quiet` en una terminal compartida.
#
# `docker-compose.dev.yml` (publicación de puertos en 127.0.0.1) NO se carga en
# producción: postgres, redis, pgbouncer, minio y typesense solo quedan expuestos
# dentro de la red de Compose.

NODE_ENV=production

# Baseline productivo: nginx termina TLS 1.3 y las cookies de sesión deben ser
# Secure (el default de desarrollo es false). La plantilla fija true para que
# `docker compose config --quiet` valide el overlay SIN variables inyectadas
# por el runner. No tocar sin ADR que cambie el baseline TLS.
COOKIE_SECURE=true

# El Stack Tecnológico aprueba PostgreSQL 18.3 y Redis 8.6 como baseline.
POSTGRES_IMAGE=postgres:18.3-alpine
REDIS_IMAGE=redis:8.6-alpine
TYPESENSE_IMAGE=typesense/typesense:28.0

# Estas referencias no tienen versión/digest aprobado en Stack_Tecnologico.md.
# Los tags siguientes son placeholders deliberadamente no operativos: tienen tag
# para impedir la resolución implícita de :latest y hacen fallar el despliegue.
# R0/R3.1 debe sustituirlos por referencias aprobadas antes de producción.
#
# Inventario de `approval-required` (riesgo 6 de ADR-070). Ninguna se sustituye
# aquí: cada una espera una decisión distinta y con dueño distinto. Sustituir
# una sin su decisión es evidencia ficticia (ADR-070 §2).
#
#   | Variable          | Decisión que la desbloquea                              | Dueño |
#   |-------------------|---------------------------------------------------------|-------|
#   | PGBOUNCER_IMAGE   | Versión + digest de pgBouncer en Stack_Tecnologico.md    | CTO   |
#   | MINIO_IMAGE       | Versión + digest de MinIO (servidor) y política de       | CTO   |
#   |                   | retención de su release line                             |       |
#   | MINIO_MC_IMAGE    | Versión + digest de `mc`, acoplada a la de MINIO_IMAGE   | CTO   |
#   | NGINX_IMAGE       | Versión + digest de Nginx; acoplada a la decisión de     | CTO   |
#   |                   | hosting y método ACME (F0.2 #2 y #3), porque determina   |       |
#   |                   | si la imagen debe traer el cliente ACME o no             |       |
#
# Las cuatro son de la misma naturaleza —fijar versión y digest en el Stack
# Tecnológico— salvo NGINX_IMAGE, que además depende del método ACME aprobado.
# Ninguna depende del FQDN.
PGBOUNCER_IMAGE=invalid/pgbouncer:approval-required
MINIO_IMAGE=invalid/minio:approval-required
MINIO_MC_IMAGE=invalid/minio-mc:approval-required
NGINX_IMAGE=invalid/nginx:approval-required

DB_BOOTSTRAP_USER=REPLACE_ME_DB_BOOTSTRAP_USER
DB_HOST=postgres
DB_PORT=5432
DB_NAME=REPLACE_ME_DB_NAME
DB_PASSWORD=REPLACE_ME_DB_PASSWORD
DB_APP_USER=REPLACE_ME_DB_APP_USER
DB_APP_PASSWORD=REPLACE_ME_DB_APP_PASSWORD
DB_MIGRATOR_USER=REPLACE_ME_DB_MIGRATOR_USER
DB_MIGRATOR_PASSWORD=REPLACE_ME_DB_MIGRATOR_PASSWORD

REDIS_HOST=redis
REDIS_PORT=6379
PGBOUNCER_PORT=6432

# Compose-compatible PEM placeholders. Single quotes preserve the literal \n
# separators; the API converts them to real newlines before loading the keys.
# Replace both values only in the ignored .env.production file.
JWT_PRIVATE_KEY='-----BEGIN PRIVATE KEY-----\nREPLACE_ME_WITH_PRIVATE_KEY_CONTENT\n-----END PRIVATE KEY-----'
JWT_PUBLIC_KEY='-----BEGIN PUBLIC KEY-----\nREPLACE_ME_WITH_PUBLIC_KEY_CONTENT\n-----END PUBLIC KEY-----'
EXECUTION_ORDER_IDEMPOTENCY_SECRET=REPLACE_ME_EXECUTION_ORDER_IDEMPOTENCY_SECRET
MFA_ENCRYPTION_KEY=REPLACE_ME_MFA_ENCRYPTION_KEY
# Solo durante una ventana de rotación; dejar vacío/ausente en operación normal.
MFA_ENCRYPTION_KEY_PREVIOUS=
PII_HASH_KEY=REPLACE_ME_PII_HASH_KEY
# SEC-P1 ventana 2 (contract): dejarla vacía/ausente salvo durante la corrida de
# cierre (`IWANA_APPLY_PII_CONTRACT=true`). Se retira al terminar; el CLI avisa
# si queda activa sin contracts pendientes.
IWANA_APPLY_PII_CONTRACT=
# Opcional: dejar vacíos hasta que CTO apruebe umbrales con datos medidos.
OUTBOX_RELAY_LAG_DEGRADED_SECONDS=
OUTBOX_RELAY_LAG_STOPPED_SECONDS=

MINIO_ROOT_USER=REPLACE_ME_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=REPLACE_ME_MINIO_ROOT_PASSWORD
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=REPLACE_ME_S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=REPLACE_ME_S3_SECRET_ACCESS_KEY
S3_BUCKET=iwana-media
S3_FORCE_PATH_STYLE=true
STORAGE_DRIVER=minio

# URL pública requerida para que ambos bundles Next.js generen su rewrite al
# ingress. El dominio real y el certificado son decisiones pendientes del CTO.
#
# NEXT_PUBLIC_API_URL se BAKEA en el bundle en tiempo de build (`ARG` en
# apps/web/Dockerfile y apps/portal/Dockerfile). Cambiar el dominio no es un
# reinicio: obliga a reconstruir web-prod y portal-prod y produce digests
# nuevos. Consecuencia para el rollback por digest: ver
# docs/runbooks/RUNBOOK-RELEASE-ROLLBACK-v1.0.md §5.2.
NEXT_PUBLIC_API_URL=https://REPLACE_ME_PRODUCTION_DOMAIN/api/v1

# Orígenes que la API acepta por CORS y base de los enlaces de los correos
# transaccionales (reset de contraseña y verificación de email).
# Con NODE_ENV=production la API los EXIGE y rechaza cualquier valor que apunte
# a localhost/127.0.0.1: falla al arrancar con mensaje explícito en lugar de
# emitir enlaces rotos en silencio (riesgos 1 y 2 de ADR-070, Puerta 1 de
# PROMPT-PLAT-OPS-G7). Ambos dependen del FQDN aprobado, que sigue pendiente.
CORS_ORIGIN=https://REPLACE_ME_PRODUCTION_DOMAIN,https://portal.REPLACE_ME_PRODUCTION_DOMAIN
FRONTEND_URL=https://REPLACE_ME_PRODUCTION_DOMAIN

# Transporte de correo transaccional. SMTP_HOST vacío conserva el modo no
# operativo; para producción real se definen todos desde el secret store.
SMTP_HOST=REPLACE_ME_SMTP_HOST
SMTP_PORT=587
SMTP_USER=REPLACE_ME_SMTP_USER
SMTP_PASS=REPLACE_ME_SMTP_PASS
SMTP_FROM=REPLACE_ME_SMTP_FROM
SMTP_SECURE=false

TYPESENSE_API_KEY=REPLACE_ME_TYPESENSE_API_KEY
TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108

PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
