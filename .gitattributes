* text=auto eol=lf

# Los instaladores Windows requieren CRLF; el resto del repositorio usa LF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Hooks y scripts deben mantenerse en LF para evitar fallos en shell.
.husky/* text eol=lf
.husky/_/* text eol=lf
*.sh text eol=lf

