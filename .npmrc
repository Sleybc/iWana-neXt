# pnpm configuration — iWana neXt monorepo
# Hoist dev tools al root node_modules para que sean accesibles en todos los workspaces

# Herramientas de desarrollo hoisted para acceso global
public-hoist-pattern[]=eslint
public-hoist-pattern[]=@typescript-eslint/*
public-hoist-pattern[]=eslint-config-*
public-hoist-pattern[]=eslint-plugin-*
public-hoist-pattern[]=prettier
public-hoist-pattern[]=jest
public-hoist-pattern[]=ts-jest
public-hoist-pattern[]=@jest/*
public-hoist-pattern[]=jest-*
public-hoist-pattern[]=typescript
