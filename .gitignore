# Dependencias
node_modules/
.pnpm-store/

# Builds
dist/
build/
.next/
.turbo/

# Storage local de desarrollo — uploads generados por MediaService
apps/api/storage/

# Backups de base de datos — dumps con PII jamás versionados
.backups/

# Variables de entorno — NUNCA versionar secretos
.env
.env.local
.env.*
.env.*.local
# Plantilla sin secretos (SEC-02 / SEC-04)
!.env.example
!.env.production.example


# Secretos JWT y certificados — NUNCA versionar
secrets/*
!secrets/.gitkeep
secrets/*.pem
secrets/*.key
secrets/*.p12
secrets/*.crt

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Payload local de autenticación — puede contener credenciales o tokens.
login-request.json

# SO
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
# Config local de IDE. Cursor NO es superficie activa del repo (AGENTS.md ->
# AI Workflow Activo declara cuatro: Copilot, OpenCode, Codex y Claude Code).
# El adaptador .cursor/rules/ai-em-arch.mdc se retiro el 2026-08-02: duplicaba
# la activacion del modo Orquestador para un cliente no declarado, y al estar
# ignorado no era auditable ni sincronizable. No deposites aqui gobernanza del
# repo: vive en AGENTS.md, docs/roles/ y docs/prompts/.
.cursor/

# Tests
coverage/
test-results/
playwright-report/
blob-report/
*.trace
*.har

# Playwright MCP artifacts
.playwright-mcp/

# Next.js
.next/
out/

# Cache
*.tsbuildinfo
.eslintcache
.claude/worktrees/
.claude/settings.local.json
**/__pycache__/
*.pyc

# Worktrees
.worktrees/

# Planes de sesion de herramientas locales (efimeros, nombrados por sesion).
# Los planes del proyecto se versionan en docs/plans/.
.zcode/

# Artefactos de compilacion que no deben contaminar src/ (el build va a dist/)
packages/database/src/**/*.js
packages/database/src/**/*.js.map
packages/database/src/**/*.d.ts
packages/database/src/**/*.d.ts.map
packages/shared/src/**/*.js
packages/shared/src/**/*.js.map
packages/shared/src/**/*.d.ts
packages/shared/src/**/*.d.ts.map
packages/storage/src/**/*.js
packages/storage/src/**/*.js.map
packages/storage/src/**/*.d.ts
packages/storage/src/**/*.d.ts.map

# Herramientas IA y artefactos locales de sesion (no versionar)
.kilo/
artifacts/
/screenshot-*.png
