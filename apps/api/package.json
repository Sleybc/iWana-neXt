{
  "name": "@iwana/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "cross-env NODE_ENV=development nest start --watch",
    "start": "node dist/main",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.js --passWithNoTests",
    "test:coverage:tenant-service": "jest --runInBand --runTestsByPath src/modules/tenant/tenant.service.spec.ts --coverage --collectCoverageFrom=modules/tenant/tenant.service.ts --coverageReporters=text-summary --coverageReporters=json-summary",
    "test:coverage:tenant-controller": "jest --runInBand --runTestsByPath src/modules/tenant/tenant.controller.spec.ts src/modules/tenant/tenant.controller.http.spec.ts src/modules/tenant/tenant.swagger.spec.ts --coverage --collectCoverageFrom=modules/tenant/tenant.controller.ts --coverageReporters=text-summary --coverageReporters=json-summary",
    "test:coverage:media-service": "jest --runInBand --runTestsByPath src/modules/media/media.service.spec.ts --coverage --collectCoverageFrom=modules/media/media.service.ts --coverageReporters=text-summary --coverageReporters=json-summary",
    "encryption:reencrypt": "node dist/cli/reencrypt-aes.js",
    "clean": "node ../../scripts/clean-paths.mjs dist"
  },
  "dependencies": {
    "@hapi/joi": "^17.1.1",
    "@iwana/db": "workspace:*",
    "@iwana/shared": "workspace:*",
    "@iwana/storage": "workspace:*",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.14",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.14",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.14",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "@types/helmet": "^4.0.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.71.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "image-size": "^2.0.2",
    "ioredis": "^5.10.0",
    "joi": "^18.2.1",
    "jszip": "^3.10.1",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.1",
    "otplib": "^13.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.17.1",
    "pg": "^8.16.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.31",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@iwana/config": "workspace:*",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.14",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.11",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.2",
    "@types/pg": "^8.11.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.0",
    "jest": "^29.0.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.0.0",
    "typescript": "^5.9.0"
  }
}
