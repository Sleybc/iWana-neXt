{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@iwana/config/tsconfig/nestjs",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "strictPropertyInitialization": false,
    "types": ["jest", "node"],
    "paths": {
      "@iwana/api": ["./src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
