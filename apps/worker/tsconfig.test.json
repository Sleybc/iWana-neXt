{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.typecheck.json",
  "compilerOptions": {
    "types": ["jest", "node"],
    "noEmit": true
  },
  "include": [
    "src/**/*",
    "../../packages/database/src/**/*",
    "../../packages/shared/src/**/*",
    "../../packages/storage/src/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
