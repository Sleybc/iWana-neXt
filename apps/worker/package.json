{
  "name": "@iwana/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "node ../../scripts/clean-paths.mjs dist && cross-env NODE_ENV=development nest start --watch",
    "start": "node dist/main",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
