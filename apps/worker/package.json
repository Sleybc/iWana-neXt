    "clean": "node ../../scripts/clean-paths.mjs dist"
  },
  "dependencies": {
    "@iwana/db": "workspace:*",
    "@iwana/shared": "workspace:*",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.14",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.14",
    "@nestjs/platform-express": "^11.1.14",
    "@nestjs/typeorm": "^11.0.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.70.0",
    "ioredis": "^5.10.0",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "typeorm": "0.3.28"
  },
  "devDependencies": {
    "@iwana/config": "workspace:*",
    "@nestjs/cli": "^11.0.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.18.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.9.0"
  }
