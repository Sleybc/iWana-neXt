{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "orchestrator": {
      "description": "Agente maestro EM + Architect unificado para iWana neXt",
      "mode": "primary",
      "model": "anthropic/claude-sonnet-4-20250514",
      "prompt": "{file:./agents/orchestrator.md}",
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "rg *": "allow"
        },
        "task": {
          "*": "deny",
          "planner-em": "allow",
          "architect-reviewer": "allow",
          "mixed-governance": "allow"
        }
      }
    },
    "planner-em": {
      "description": "Subagente de planificacion, sprint tracking e informes (Modo EM)",
      "mode": "subagent",
      "prompt": "{file:./agents/planner-em.md}",
      "permission": {
        "edit": "allow",
        "bash": "deny"
      }
    },
    "architect-reviewer": {
      "description": "Subagente de review tecnico, ADR, HLD, boundaries y seguridad (Modo Architect)",
      "mode": "subagent",
      "prompt": "{file:./agents/architect-reviewer.md}",
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "deny",
          "git diff*": "allow",
          "git log*": "allow",
          "rg *": "allow"
        }
      }
    },
    "mixed-governance": {
      "description": "Subagente de inicio de modulo, governance y cumplimiento regulatorio (Modo Mixto)",
      "mode": "subagent",
      "prompt": "{file:./agents/mixed-governance.md}",
      "permission": {
        "edit": "allow",
        "bash": "deny"
      }
    }
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true,
      "timeout": 15000
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp@latest"],
      "enabled": true,
      "timeout": 15000
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true,
      "timeout": 15000
    }
  },
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"]
}
