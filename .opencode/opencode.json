{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".github/copilot-instructions.md"],
  "skills": {
    "paths": [".agents/skills"]
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["pnpm", "dlx", "chrome-devtools-mcp@1.10.1"],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": ["pnpm", "dlx", "@upstash/context7-mcp@4.1.1"],
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "playwright": {
      "type": "local",
      "command": ["pnpm", "dlx", "@playwright/mcp@0.0.82"],
      "enabled": true
    },
    "postgres-dev": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "--network",
        "container:iwana_postgres_dev",
        "--env-file",
        ".claude/mcp-postgres.local.env",
        "crystaldba/postgres-mcp@sha256:dbbd346860d29f1543e991f30f3284bf4ab5f096d049ecc3426528f20b1b6e6b",
        "--access-mode=restricted"
      ],
      "enabled": true
    }
  }
}
